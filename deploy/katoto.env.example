# Production settings, installed by setup.sh as /etc/katoto/katoto.env
# (owner root, mode 600). This template holds NO secrets: SMTP_PASS is set by
# set-smtp-password.sh, and the admin password by admin-password.sh.
APP_BASE_URL=https://__DOMAIN__
ADMIN_EMAIL=__ADMIN_EMAIL__

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=__ADMIN_EMAIL__
SMTP_PASS=
MAIL_FROM=__ADMIN_EMAIL__
NOTIFY_EMAIL=__ADMIN_EMAIL__

PORT=8787
DATA_DIR=/var/lib/katoto
BACKUP_DIR=/var/backups/katoto
BACKUP_KEEP=14
# Caddy runs on the same machine.
TRUST_PROXY=loopback
STATS_TIME_ZONE=Asia/Manila
