# Copy to .env and fill in. Never commit .env.

# Initial administrator — used ONCE, only while the database has no users.
# After the first sign-in, change the password from Admin → Account, then
# remove ADMIN_INITIAL_PASSWORD from .env. The value is stored only as a
# scrypt hash in the database.
# Wrap values containing # in double quotes, or the rest is read as a comment:
#   ADMIN_INITIAL_PASSWORD="example#1234"
ADMIN_USERNAME=
ADMIN_INITIAL_PASSWORD=

# Production mode is enabled by `npm start` (it passes --production), not by
# NODE_ENV here: Vite also reads .env, and NODE_ENV in this file would make
# `npm run build` produce a development bundle. Production mode enables
# Secure + __Host- cookies and HSTS, and blocks admin features until the
# initial password has been changed. It must be served over HTTPS.

# API / production server port (Vite proxies /api and /uploads here in dev).
PORT=8787

# Where the SQLite database (katoto.db) and uploaded images are stored.
# Must be on persistent storage and included in backups.
DATA_DIR=server-data

# Admin session lifetime in hours.
SESSION_HOURS=8

# Maximum size per uploaded image, in MB.
MAX_UPLOAD_MB=10

# Optional: extra origins allowed to send admin requests (comma-separated),
# e.g. if the admin is served from a different domain than the API.
ALLOWED_ORIGINS=

# Time zone used to group visit statistics into calendar days.
STATS_TIME_ZONE=Asia/Manila

# Maximum size per Freedom of Information document (PDF, image, Word, Excel), in MB.
MAX_DOCUMENT_MB=25

# Optional: email notifications for contact-form messages. Messages are always
# saved in Admin → Messages; these settings only add an email alert.
# For Gmail, turn on 2-Step Verification and create an App Password
# (Google Account → Security → App passwords); never use the real password.
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address (usually the same as SMTP_USER).
MAIL_FROM=
# Where notifications go. Empty = the contact email published on the site.
NOTIFY_EMAIL=

# Retention (days). Contact messages, and privacy requests after they are
# closed, are deleted automatically after these periods. Proposed defaults;
# Katoto Project should confirm them (the Privacy Policy shows these values).
MESSAGE_RETENTION_DAYS=365
PRIVACY_REQUEST_RETENTION_DAYS=365

# Admin account security.
# The admin account's registered email: lockout alerts, recovery links, and
# verification links for password/username changes go only to this address.
ADMIN_EMAIL=
# Base address of the website used in emailed links, e.g. https://katoto.example.
# Must be https:// in production (http://localhost is allowed in development).
# Links are never built from the request's Host header.
APP_BASE_URL=
# How long security log entries are kept (days).
SECURITY_LOG_RETENTION_DAYS=365

# Which proxies may report the visitor's IP address (used by rate limits).
# Default "loopback" = only a proxy on the same machine. Behind a hosting
# platform's load balancer, use the number of proxy hops, usually 1.
TRUST_PROXY=loopback
